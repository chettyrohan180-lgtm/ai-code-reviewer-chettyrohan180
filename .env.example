# ─────────────────────────────────────────────────────────────────
# Autonomous AI Code Reviewer — Environment Variables
# Copy this file to `.env` and fill in your real values.
# NEVER commit `.env` to version control.
# ─────────────────────────────────────────────────────────────────

# ── GitHub App Configuration ──────────────────────────────────────
# Your GitHub App's numeric ID (shown on the App settings page)
GITHUB_APP_ID=123456

# Path to the private key (.pem) file downloaded from your GitHub App
GITHUB_PRIVATE_KEY_PATH=./secrets/github_app.pem

# The webhook secret you set when creating the GitHub App
GITHUB_WEBHOOK_SECRET=your_super_secret_webhook_token_here

# ── FastAPI Server ─────────────────────────────────────────────────
# Port the server listens on
PORT=8000

# Set to "production" in prod environments
APP_ENV=development

# ── LLM Configuration (used in later steps) ──────────────────────
OPENAI_API_KEY=sk-...
